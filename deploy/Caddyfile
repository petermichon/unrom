# unrom — reverse proxy for the compose deployment (`proxy` profile).
#
# If you run your own proxy on the host, point it at the published ports
# instead (they are bound to 127.0.0.1):
#   /api/*        -> 127.0.0.1:3000
#   everything else -> 127.0.0.1:3001

unrom.com {
	# Transport compression for HTML/CSS/JS/JSON (browsers decode transparently).
	encode zstd gzip

	# Same-origin API — the frontend calls /api/* with no CORS.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Web app (SSR, Node).
	handle {
		reverse_proxy web:3001
	}
}

# Optional: redirect the www host to the canonical apex.
www.unrom.com {
	redir https://unrom.com{uri} permanent
}
