{
  "name": "unrom",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "web",
    "server",
    "contract"
  ],
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "dev:host": "node --disable-warning=ExperimentalWarning scripts/dev.ts --host",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web",
    "check": "npm run typecheck --workspace web && npm run check --workspace server && npm run check --workspace contract && npm run check:scripts",
    "check:scripts": "tsc -p scripts",
    "lint": "npm run lint --workspace web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test",
    "verify:all": "npm run verify && npm run test:e2e",
    "audit": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "hooks": "git config core.hooksPath .githooks",
    "test": "npm run test --workspace server",
    "test:e2e": "playwright test",
    "ingest": "npm run ingest --workspace server",
    "build:data": "npm run build:data --workspace server",
    "refresh": "npm run ingest && npm run build:data && npm run verify && git status --short data/",
    "refresh:auto": "bash scripts/refresh-data.sh",
    "registry:suggest": "npm run registry:suggest --workspace server",
    "api": "npm run start --workspace server",
    "catalog:report": "npm run catalog:report --workspace server"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.7"
  }
}
