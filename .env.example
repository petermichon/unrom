# Copy to `.env` and adjust for the host. Loaded by systemd via
# `EnvironmentFile` (see `deploy/`); Node scripts do not auto-load it.

# Data pipeline — relative paths resolve against the process working directory.
DATA_DIR=/srv/unrom/data
OUT_DIR=/srv/unrom/server/dist
DB_PATH=/srv/unrom/server/dist/unrom.sqlite

# API
HOST=127.0.0.1
PORT=3000

# Web — Vite dev proxy, and later the SSR loaders.
API_URL=http://127.0.0.1:3000

# Reproducible builds: pin the snapshot timestamp (seconds since epoch).
# SOURCE_DATE_EPOCH=
